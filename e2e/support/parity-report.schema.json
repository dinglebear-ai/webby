{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webby.local/e2e/parity-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "contract_hash", "source_revision", "toolchain_fingerprint", "world_nonce", "seed", "adapter", "results"],
  "properties": {
    "contract_version": {"const": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "toolchain_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "world_nonce": {"type": "string", "minLength": 32},
    "seed": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["protocol", "chromium"]},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "outcomes", "raw_observables", "required_raw_keys"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^e2e-[a-z0-9-]+$"},
          "outcomes": {"type": "object", "minProperties": 1},
          "raw_observables": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "value", "normalized_as"],
              "properties": {
                "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
                "value": {},
                "normalized_as": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
              }
            }
          },
          "required_raw_keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true}
        }
      }
    }
  }
}
